{
	"name": "n8n-nodes-netsuite-v2",
	"version": "0.2.0",
	"description": "n8n community node for NetSuite using OAuth 2.0 Client Credentials with Certificate (JWT/PS256)",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package"
	],
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"credentials": [
			"dist/credentials/NetSuiteClientCredApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/NetSuite/NetSuite.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.12.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"overrides": {
		"change-case": "4.1.2"
	}
}
