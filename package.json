{
	"name": "@invoqtech/n8n-nodes-netsuite",
	"version": "1.0.0",
	"description": "Oracle NetSuite for n8n by InvoQ Technologies - REST records, SuiteQL, RESTlets and polling triggers with unattended OAuth 2.0 Client Credentials (certificate / M2M) authentication",
	"license": "MIT",
	"author": {
		"name": "InvoQ Technologies",
		"email": "avishai@invoqtech.com",
		"url": "https://invoqtech.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/invoqtech/n8n-nodes-netsuite.git"
	},
	"homepage": "https://github.com/invoqtech/n8n-nodes-netsuite#readme",
	"bugs": {
		"url": "https://github.com/invoqtech/n8n-nodes-netsuite/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"netsuite",
		"oracle-netsuite",
		"erp",
		"suiteql",
		"restlet",
		"suitescript",
		"suitetalk",
		"rest-api",
		"oauth2",
		"client-credentials",
		"m2m",
		"jwt",
		"automation",
		"netsuite-integration",
		"netsuite-rest-api",
		"netsuite-connector",
		"polling-trigger",
		"invoq",
		"suitetalk-rest",
		"finance-automation"
	],
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "node --test test/*.test.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/NetSuiteInvoqApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/NetSuite/NetSuite.node.js",
			"dist/nodes/NetSuite/NetSuiteTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.5",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.12.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
