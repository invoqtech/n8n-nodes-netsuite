	},
	"homepage": "https://solutionlabtech.com",
	"bugs": {
		"url": "https://github.com/avishaiasaf/n8n-netsuite-node-v2/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"netsuite",
		"oracle-netsuite",
		"erp",
		"suiteql",
		"restlet",
		"suitescript",
		"suitetalk",
		"rest-api",
		"oauth2",
		"client-credentials",
		"m2m",
		"jwt",
